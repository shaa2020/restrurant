# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings → API). Use an EU region project. ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key is safe for the browser — RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used exclusively by verified webhooks / admin jobs. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public URL of this app (used for auth email redirects and QR codes).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact address for the Enterprise plan; the button is hidden when unset.
NEXT_PUBLIC_SALES_EMAIL=

# --- Stripe (Stage 4/8) — server-only ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Error monitoring (optional) ---
SENTRY_DSN=

# --- Local DB tests (npm run db:test) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
